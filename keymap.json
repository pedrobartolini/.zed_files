[
  {
    "context": "",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-q": null,
      "ctrl-shift-c": "editor::Copy",
      "ctrl-insert": "project_panel::ToggleFocus",
      "ctrl-home": "git_panel::ToggleFocus",
      "ctrl-pageup": "agent::Toggle",
      "ctrl-pagedown": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  {
    "context": "Editor && !(showing_completions || edit_prediction || (edit_prediction && (showing_completions || in_leading_whitespace)))",
    "bindings": { "tab": ["workspace::SendKeystrokes", "\t"] },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-;": "editor::ToggleComments",
      "ctrl-/": null,
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-e": "file_finder::Toggle"
    }
  }
]
