{
  // THEME
  "relative_line_numbers": "disabled",
  "diff_view_style": "unified",
  "scrollbar": {
    "selected_text": true,
    "cursors": true,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "scroll_sensitivity": 1.0,
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "prettier": {
    "allowed": true,
  },
  "format_on_save": "on",
  "agent": {
    "message_editor_min_lines": 4,
    "show_turn_stats": true,
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "play_sound_when_agent_done": "always",
    "notify_when_agent_waiting": "all_screens",
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "GitHub Dark Dimmed",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },

  // UI
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "collaboration_panel": { "button": false,
                           "dock": "right" },
  "outline_panel": { "button": false, "dock": "right" },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "entry_spacing": "standard",
    "sticky_scroll": false,
  },
  "toolbar": { "breadcrumbs": false, "quick_actions": false },
  "tabs": { "file_icons": true },

  // BUFFER
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "buffer_font_weight": 400,
  "buffer_font_features": { "calt": true },
  "current_line_highlight": "none",
  "indent_guides": { "enabled": true },
  "gutter": {
    "min_line_number_digits": 0,
    "bookmarks": false,
    "breakpoints": false,
    "line_numbers": true,
    "folds": false,
    "runnables": false,
  },
  "inline_code_actions": false,

  // MINIMAP
  "minimap": {
    "show": "always",
    "current_line_highlight": "none",
    "thumb": "hover",
    "thumb_border": "none",
  },

  // ACTIONS
  "base_keymap": "VSCode",
  "tab_size": 2,
  "double_click_in_multibuffer": "open",
  "extend_comment_on_newline": false,

  // TERMINAL
  "terminal": {
    "scroll_multiplier": 1.0,
    "cursor_shape": "bar",
    "button": false,
    "shell": "system",
  },

  // LSP and AGENT
  "show_edit_predictions": false,
  "completions": { "lsp_insert_mode": "replace_suffix" },
  "language_servers": ["!eslint", "!typescript-language-server", "..."],

  // GIT
  "git": {
    "inline_blame": { "enabled": false },
    "git_gutter": "tracked_files",
  },
  "git_panel": { "dock": "left", "sort_by": "path" },

  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },
}
